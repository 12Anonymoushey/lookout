# Port for the Express + Socket.IO realtime server.
# NOTE: Render injects PORT automatically — this is only for local runs.
PORT=4000

# Allowed origins for CORS + Socket.IO. Comma-separated list. Defaults to "*".
# Recommended once your Cloudflare Pages domain is live:
# CORS_ORIGIN=https://look-out.pages.dev,http://localhost:5173

