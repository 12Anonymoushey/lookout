# Backend base URL used for BOTH REST calls and the Socket.IO connection.
#
# - Local development:  VITE_BACKEND_URL=http://localhost:4000
# - Production:         set this in the Cloudflare Pages dashboard
#                       (Production AND Preview environments) to your Render URL.
# If unset, the app falls back to the deployed Render instance below.
# Trailing slashes are stripped automatically.
#VITE_BACKEND_URL=http://localhost:4000
