# Backend base URL used for BOTH REST calls and the Socket.IO connection.
#
# - Default (no env var): the app already falls back to the LIVE Render
#   instance -> https://lookout-p8fw.onrender.com (recommended for local dev).
# - Local-only backend (for offline demos): VITE_BACKEND_URL=http://localhost:4000
# - Production (Cloudflare Pages): set this in the Pages dashboard
#   (Production AND Preview environments) to your Render URL.
# Trailing slashes are stripped automatically.
#VITE_BACKEND_URL=http://localhost:4000
